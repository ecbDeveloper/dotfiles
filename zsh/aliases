alias bp='nvim ~/.zshrc'
alias sa='source ~/.zshrc;echo "ZSH aliases sourced."'

# vpn aliases
alias vpn-on='sudo systemctl start openvpn-client@SP01.service; echo "VPN turned on successfully"'
alias vpn-off='sudo systemctl stop openvpn-client@SP01.service; echo "VPN turned off successfully"'

# git aliases
alias gs='git status'
alias ga='git add'
alias gp='git push'
alias gpo='git push origin'
alias gtd='git tag --delete'
alias gtdr='git tag --delete origin'
alias gr='git branch -r'
alias gplo='git pull origin'
alias gb='git branch '
alias gc='git commit'
alias gd='git diff'
alias gco='git checkout '
alias gl='git log'
alias gr='git remote'
alias grs='git remote show'
alias glo='git log --pretty="oneline"'
alias glol='git log --graph --oneline --decorate'

